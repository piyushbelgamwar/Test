import java.io.ByteArrayInputStream;
import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.io.InputStream;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.Base64;
import java.util.List;
import java.util.zip.CRC32;
import java.util.zip.Deflater;
import java.util.zip.GZIPInputStream;
import java.util.zip.GZIPOutputStream;

/**
 * MultiLayerCompressor - 3-fold (configurable) GZIP compression to photo-friendly text, and back.
 *
 * COMPRESS  : file bytes -> GZIP x LAYERS -> Base64 -> wrap at 40 chars/line
 * DECOMPRESS: join lines -> Base64 decode -> GUNZIP x LAYERS -> verify CRC32 + size -> file
 *
 * Output format:
 *   Line 1   : MLC1|layers=3|name=Foo.java|bytes=412345|lines=10000|crc=123456789
 *   Line 2..N: Base64 payload, 40 chars per line
 *
 * The layer count is stored in the header, so decompress never needs to be told it.
 *
 * Usage:
 *   java MultiLayerCompressor.java compress   <input> <output> [layers]
 *   java MultiLayerCompressor.java decompress <input> <output>
 */
public class MultiLayerCompressor {

    public static final int DEFAULT_LAYERS = 3;
    public static final int LINE_WIDTH = 40;
    private static final String MAGIC = "MLC1";

    // ─────────────────────────────────────────────
    //  COMPRESS
    // ─────────────────────────────────────────────
    public static void compress(Path input, Path output, int layers) throws IOException {
        if (layers < 1) throw new IllegalArgumentException("layers must be >= 1");

        byte[] original = Files.readAllBytes(input);
        long lineCount = countLines(original);
        long crc = crc32(original);

        System.out.printf("Input          : %s (%,d lines, %,d bytes)%n", input, lineCount, original.length);

        byte[] data = original;
        for (int i = 1; i <= layers; i++) {
            data = gzip(data);
            System.out.printf("After layer %-3d: %,d bytes%n", i, data.length);
        }

        String encoded = Base64.getEncoder().encodeToString(data);

        List<String> out = new ArrayList<>();
        out.add(String.join("|",
                MAGIC,
                "layers=" + layers,
                "name=" + input.getFileName().toString().replace("|", "_"),
                "bytes=" + original.length,
                "lines=" + lineCount,
                "crc=" + crc));
        for (int i = 0; i < encoded.length(); i += LINE_WIDTH) {
            out.add(encoded.substring(i, Math.min(i + LINE_WIDTH, encoded.length())));
        }
        Files.write(output, out, StandardCharsets.US_ASCII);

        System.out.printf("Output         : %s (%,d lines, %,d bytes)%n", output, out.size(), Files.size(output));
        System.out.printf("Line reduction : %,d -> %,d  (%.1fx)%n", lineCount, out.size(), (double) lineCount / out.size());
    }

    // ─────────────────────────────────────────────
    //  DECOMPRESS
    // ─────────────────────────────────────────────
    public static void decompress(Path input, Path output) throws IOException {
        List<String> lines = Files.readAllLines(input, StandardCharsets.US_ASCII);
        if (lines.isEmpty() || !lines.get(0).startsWith(MAGIC + "|")) {
            throw new IllegalArgumentException("Not an MLC1 file (missing header line)");
        }

        Header h = Header.parse(lines.get(0));

        StringBuilder payload = new StringBuilder();
        for (int i = 1; i < lines.size(); i++) {
            payload.append(lines.get(i).replaceAll("\\s", "")); // tolerate stray spaces/CRLF
        }

        byte[] data;
        try {
            data = Base64.getDecoder().decode(payload.toString());
        } catch (IllegalArgumentException e) {
            throw new IOException("Base64 payload is corrupted (check for mistyped/OCR characters): " + e.getMessage(), e);
        }

        for (int i = h.layers; i >= 1; i--) {
            try {
                data = gunzip(data);
            } catch (IOException e) {
                throw new IOException("Payload corrupted - failed un-gzipping layer " + i
                        + " (a character in the Base64 lines was changed/lost): " + e.getMessage(), e);
            }
        }

        if (data.length != h.bytes) {
            throw new IOException("Size mismatch: expected " + h.bytes + " bytes, got " + data.length);
        }
        long crc = crc32(data);
        if (crc != h.crc) {
            throw new IOException("CRC32 mismatch: expected " + h.crc + ", got " + crc);
        }

        Files.write(output, data);
        System.out.printf("Restored       : %s (%,d lines, %,d bytes) - CRC32 OK, %d layers%n",
                output, countLines(data), data.length, h.layers);
    }

    // ─────────────────────────────────────────────
    //  HELPERS
    // ─────────────────────────────────────────────
    static byte[] gzip(byte[] in) throws IOException {
        ByteArrayOutputStream baos = new ByteArrayOutputStream(Math.max(64, in.length / 2));
        try (GZIPOutputStream gz = new GZIPOutputStream(baos) {
            { def.setLevel(Deflater.BEST_COMPRESSION); }
        }) {
            gz.write(in);
        }
        return baos.toByteArray();
    }

    static byte[] gunzip(byte[] in) throws IOException {
        try (InputStream gz = new GZIPInputStream(new ByteArrayInputStream(in))) {
            return gz.readAllBytes();
        }
    }

    static long crc32(byte[] data) {
        CRC32 c = new CRC32();
        c.update(data);
        return c.getValue();
    }

    static long countLines(byte[] data) {
        if (data.length == 0) return 0;
        long n = 0;
        for (byte b : data) if (b == '\n') n++;
        return data[data.length - 1] == '\n' ? n : n + 1;
    }

    private record Header(int layers, long bytes, long crc) {
        static Header parse(String line) {
            int layers = -1;
            long bytes = -1, crc = -1;
            for (String part : line.split("\\|")) {
                int eq = part.indexOf('=');
                if (eq < 0) continue;
                String k = part.substring(0, eq), v = part.substring(eq + 1);
                switch (k) {
                    case "layers" -> layers = Integer.parseInt(v);
                    case "bytes" -> bytes = Long.parseLong(v);
                    case "crc" -> crc = Long.parseLong(v);
                    default -> { }
                }
            }
            if (layers < 1 || bytes < 0 || crc < 0) {
                throw new IllegalArgumentException("Header missing layers/bytes/crc: " + line);
            }
            return new Header(layers, bytes, crc);
        }
    }

    // ─────────────────────────────────────────────
    //  CLI
    // ─────────────────────────────────────────────
    public static void main(String[] args) throws IOException {
        if (args.length < 3) {
            System.err.println("""
                    Usage:
                      compress   <input> <output> [layers, default 3]
                      decompress <input> <output>""");
            System.exit(1);
        }
        switch (args[0]) {
            case "compress" -> compress(Path.of(args[1]), Path.of(args[2]),
                    args.length > 3 ? Integer.parseInt(args[3]) : DEFAULT_LAYERS);
            case "decompress" -> decompress(Path.of(args[1]), Path.of(args[2]));
            default -> {
                System.err.println("Unknown command: " + args[0]);
                System.exit(1);
            }
        }
    }
}
